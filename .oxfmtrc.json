{
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 100,
  "semi": true,
  "quotes": "double",
  "singleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "none",
  "bracketSpacing": true,
  "arrowParens": "always",
  "jsxSingleQuote": false,
  "sortImports": true,
  "sortPackageJson": true,
  "sortTailwindcss": true,
  "jsdoc": true
}
