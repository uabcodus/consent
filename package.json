{
  "name": "@uabcodus/consent",
  "version": "0.0.1",
  "description": "Headless, highly composable, client-side consent management library.",
  "keywords": [
    "composable",
    "consent",
    "cookie",
    "gdpr",
    "headless",
    "react",
    "vanilla"
  ],
  "homepage": "https://github.com/uabcodus/consent#readme",
  "bugs": {
    "url": "https://github.com/uabcodus/consent/issues"
  },
  "license": "MIT",
  "author": "UAB Codus",
  "repository": {
    "type": "git",
    "url": "https://github.com/uabcodus/consent"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --no-error-on-unmatched-pattern",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "tsdown": "^0.22.3",
    "typescript": "^5.8.0",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "nano-staged": {
    "src/**/*.{ts,tsx}": "bun run lint",
    "tsdown.config.ts": "bun run lint",
    "*": "bun run format -- --no-error-on-unmatched-pattern"
  }
}
