{
  "name": "@uabcodus/consent",
  "version": "0.0.1",
  "description": "Headless, highly composable, client-side consent management library.",
  "keywords": [
    "composable",
    "consent",
    "cookie",
    "gdpr",
    "headless",
    "react",
    "vanilla"
  ],
  "homepage": "https://github.com/uabcodus/consent#readme",
  "bugs": {
    "url": "https://github.com/uabcodus/consent/issues"
  },
  "license": "MIT",
  "author": "UAB Codus",
  "repository": {
    "type": "git",
    "url": "https://github.com/uabcodus/consent"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "tsdown": "^0.22.3",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
